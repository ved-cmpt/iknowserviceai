# Build context for deploy/Dockerfile. An allowlist would be stricter, but these are the only two
# folders it copies from, and secrets and history must never enter the context.
**
!frontend/
!backend/
frontend/node_modules
frontend/dist
frontend/src/tests
frontend/.env*
backend/tests
backend/eval
backend/.venv
backend/.env*
**/__pycache__
**/.pytest_cache
**/.ruff_cache
