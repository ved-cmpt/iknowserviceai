# Copy to .env.prod and replace every placeholder. Used by compose.prod.yaml. Never commit .env.prod.
# Use letters and digits in the passwords: they go inside connection URLs.

POSTGRES_USER=owner
POSTGRES_PASSWORD=<replace-with-a-generated-password>
POSTGRES_DB=iknowserviceai
# The password of app_user, the role the running app connects as.
APP_DB_PASSWORD=<replace-with-a-different-generated-password>

# At least 32 random characters.
JWT_SECRET=<replace-with-a-long-random-string>

AI_MODE=mock
GEMINI_API_KEY=
GEMINI_MODEL=

# true shows the demo accounts, public password and banner, and turns on the volume caps and,
# if the database has enabled it, the daily reset (ADR-051).
DEMO_MODE=false
# Needed by the seed and reset commands, and shown on the page when DEMO_MODE=true.
DEMO_PASSWORD=
ALLOW_DEMO_RESET=false

# How many trusted proxies sit in front of the app. A typical host has 1. 0 means no proxy.
# Wrong values let clients forge their address or make everyone share one rate limit.
TRUSTED_PROXY_HOPS=0
# Turn on only when the site is served over HTTPS.
HSTS_ENABLED=false

APP_HOST_PORT=8080
