# Copy to .env and replace JWT_SECRET. Placeholders only: never commit real secrets.

# --- Backend ---
APP_ENV=development
# The app connects as the least-privilege role app_user (ADR-047).
DATABASE_URL=postgresql+psycopg://app_user:localapppassword@db:5432/iknowserviceai
# Migrations and the demo reset use the owner role.
MIGRATION_DATABASE_URL=postgresql+psycopg://app:localpassword@db:5432/iknowserviceai
# Integration tests run against this database. Its name must contain "test".
TEST_DATABASE_URL=postgresql+psycopg://app:localpassword@db:5432/iknowserviceai_test
# The same test database as app_user, to prove what that role cannot do.
TEST_APP_DATABASE_URL=postgresql+psycopg://app_user:localapppassword@db:5432/iknowserviceai_test
# Must be at least 32 characters. See README for how to generate one.
JWT_SECRET=<replace-with-a-long-random-string>
ACCESS_TOKEN_MINUTES=10
# How long one sign-in lasts, across reloads, before signing in again is required.
REFRESH_TOKEN_HOURS=8
CORS_ALLOWED_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO

# --- AI ---
# mock is deterministic and uses no network. gemini calls the API and needs the next two values.
AI_MODE=mock
GEMINI_API_KEY=
GEMINI_MODEL=<choose-a-free-tier-flash-model>
AI_REQUEST_TIMEOUT_SECONDS=45
AI_MAX_OUTPUT_TOKENS=2048
AI_THINKING_LEVEL=low
AI_REVIEW_CONFIDENCE_THRESHOLD=0.70
# Analysis attempts per request, then 429 ANALYZE_LIMIT_REACHED. Staff can still triage manually.
AI_MAX_ANALYZE_ATTEMPTS=3
# A run older than this no longer blocks a new analysis.
AI_STALE_RUN_SECONDS=120

# --- Rate limits (in-process, see ADR-030) ---
# Per IP address and email.
RATE_LIMIT_LOGIN_PER_MINUTE=5
# Per user.
RATE_LIMIT_ANALYZE_PER_HOUR=10
# Per IP address.
RATE_LIMIT_REFRESH_PER_MINUTE=60

# --- Knowledge retrieval ---
# Relevance floor (ts_rank_cd) applied by KnowledgeRetriever. See ADR-016.
KB_MIN_RANK=0.5

# --- Demo data ---
# Intentionally public credential shared by the fictional demo accounts.
# It protects synthetic data only. Do not reuse it anywhere real.
DEMO_PASSWORD=demo-only-public-2026
ALLOW_DEMO_RESET=true

# --- Database container ---
POSTGRES_USER=app
POSTGRES_PASSWORD=localpassword
POSTGRES_DB=iknowserviceai
# The password of app_user, created when the database volume is first initialized.
APP_DB_PASSWORD=localapppassword
# Change this if a local PostgreSQL already uses 5432.
POSTGRES_HOST_PORT=5432

# --- Dev reload on Windows bind mounts ---
WATCHFILES_FORCE_POLLING=true
VITE_USE_POLLING=true
