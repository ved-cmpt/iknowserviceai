# Copy to .env and replace JWT_SECRET. Placeholders only: never commit real secrets.

# --- Backend ---
APP_ENV=development
DATABASE_URL=postgresql+psycopg://app:localpassword@db:5432/iknowserviceai
# Integration tests run against this database. Its name must contain "test".
TEST_DATABASE_URL=postgresql+psycopg://app:localpassword@db:5432/iknowserviceai_test
# Must be at least 32 characters. See README for how to generate one.
JWT_SECRET=<replace-with-a-long-random-string>
ACCESS_TOKEN_MINUTES=30
CORS_ALLOWED_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO

# --- AI (mock only until Chunk 3; nothing calls Gemini yet) ---
AI_MODE=mock
GEMINI_API_KEY=
GEMINI_MODEL=<choose-supported-model-at-implementation>
AI_REQUEST_TIMEOUT_SECONDS=20
AI_REVIEW_CONFIDENCE_THRESHOLD=0.70

# --- Knowledge retrieval ---
# Relevance floor (ts_rank_cd) applied by KnowledgeRetriever. See ADR-016.
KB_MIN_RANK=0.05

# --- Demo data ---
# Intentionally public credential shared by the fictional demo accounts.
# It protects synthetic data only. Do not reuse it anywhere real.
DEMO_PASSWORD=demo-only-public-2026
ALLOW_DEMO_RESET=true

# --- Database container ---
POSTGRES_USER=app
POSTGRES_PASSWORD=localpassword
POSTGRES_DB=iknowserviceai
# Change this if a local PostgreSQL already uses 5432.
POSTGRES_HOST_PORT=5432

# --- Dev reload on Windows bind mounts ---
WATCHFILES_FORCE_POLLING=true
VITE_USE_POLLING=true

# --- Frontend (public: VITE_ values reach the browser, never put secrets here) ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_SHOW_DEMO_HINT=true
