{
  "name": "iknowserviceai-e2e",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Browser E2E suite. Runs in Docker: npm --prefix e2e run e2e",
  "scripts": {
    "e2e": "node run.mjs",
    "e2e:prod": "node run-prod.mjs",
    "e2e:smoke": "node run-prod.mjs --project=desktop --grep @smoke",
    "screenshots": "node run-prod.mjs --project=screenshots"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1"
  }
}
